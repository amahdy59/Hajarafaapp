# =======================================================
# Haj Arafa Storefront - Cloudflare & Environment Config
# =======================================================

# Cloudflare Domain / Zone URL
VITE_CLOUDFLARE_ZONE_URL=https://hajarafa.com

# Cloudflare Images Delivery Base URL (Optional: leave empty to use local assets)
# Example: https://imagedelivery.net/<ACCOUNT_HASH>
VITE_CLOUDFLARE_IMAGE_DELIVERY_URL=

# Cloudflare Turnstile (Anti-Bot & Anti-Fraud for Checkout)
# Testing Site Keys provided by Cloudflare:
# - Always Passes: 1x00000000000000000000AA
# - Always Blocks: 2x00000000000000000000AB
# - Interactive Challenge: 3x00000000000000000000FF
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Cloudflare Web Analytics Token (Optional)
VITE_CLOUDFLARE_ANALYTICS_TOKEN=

# Cloudflare Workers Serverless API Base URL (Optional)
VITE_CLOUDFLARE_WORKER_API_URL=

# Official Haj Arafa WhatsApp Hotline for 1-Click Ordering (Egypt: 201...)
VITE_WHATSAPP_PHONE_NUMBER=201001234567
