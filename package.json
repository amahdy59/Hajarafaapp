{
  "name": "haj-arafa-storefront",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:a11y": "vitest run src/app/accessibility.test.ts",
    "test:code-review": "vitest run src/app/codeReview.test.ts",
    "test:perf": "vitest run src/app/performance.test.ts",
    "test:responsive": "vitest run src/app/responsiveness.test.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "review": "npm run typecheck && npm run lint && npm run test:code-review && npm run test:a11y && npm run test:responsive && npm run test:perf"
  },
  "dependencies": {
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.13.0",
    "sonner": "2.0.3",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "tailwindcss": "4.1.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "6.3.5",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
